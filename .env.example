# Inpainting Endpoint
REACT_APP_INPAINTING_ENDPOINT=XXXX

# reCAPTCHA Site Key
REACT_APP_RECAPTCHA_SITE_KEY=XXXX

# Source Maps
GENERATE_SOURCEMAP=false

# ============================================
# Google Analytics & AdSense Configuration
# ============================================

# Google Analytics Measurement ID (format: G-XXXXXXXXXX)
# Get your ID from: https://analytics.google.com/
VITE_GA_MEASUREMENT_ID=G-XE2HGPPW4V
# Alternative (for backwards compatibility):
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense Client ID (format: ca-pub-XXXXXXXXXXXXXXXX)
# Get your ID from: https://www.google.com/adsense/
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# Alternative (for backwards compatibility):
# REACT_APP_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
